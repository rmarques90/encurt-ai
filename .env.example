# Somente para desenvolvimento local. Gere uma chave secreta antes de usar fora deste ambiente.
DB_CLIENT=sqlite
SQLITE_FILE=./data/encurt-ai.sqlite
PORT=3000
BASE_URL=http://localhost:3000
WEB_BASE_URL=http://localhost:5173
DATA_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# Keep empty for direct/local access. In production, list only the reverse proxy IPs/CIDRs.
# Example for a proxy on this same machine: TRUSTED_PROXY_IPS=127.0.0.1,::1
TRUSTED_PROXY_IPS=
